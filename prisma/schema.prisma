generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARENT
  HOMEROOM
  TEACHER
  MUDIR
  ADMIN
}

enum EducationLevel {
  SD
  SMP
  SMA
}

enum AdmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum UserStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  TEXT
  VIDEO
  QUIZ
  ASSIGNMENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum Semester {
  GANJIL
  GENAP
}

enum ReportCardStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  phone        String?
  passwordHash String
  role         UserRole
  status       UserStatus   @default(PENDING)
  verifiedAt   DateTime?
  verifiedById String?
  children     StudentProfile[] @relation("ParentChildren")
  submittedAdmissions Admission[] @relation("AdmissionSubmitter")
  sessions     Session[]
  courses      Course[]     @relation("CourseCreator")
  announcements Announcement[] @relation("AnnouncementAuthor")
  reportCards  ReportCard[] @relation("ReportCardCreator")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([role])
  @@index([status])
  @@index([verifiedAt])
}

model StudentProfile {
  id            String         @id @default(uuid())
  name          String
  level         EducationLevel @default(SMP)
  studentNumber String         @unique
  className     String
  phone         String?
  address       String?
  parentId      String?
  parent        User?          @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  enrollments   Enrollment[]
  attendanceRecords AttendanceRecord[]
  gradeRecords  GradeRecord[]
  reportCards   ReportCard[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([name])
  @@index([className])
  @@index([level])
  @@index([parentId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Course {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  description String
  level       EducationLevel @default(SMP)
  status      CourseStatus   @default(PUBLISHED)
  createdById String?
  createdBy   User?        @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lessons     Lesson[]
  enrollments Enrollment[]
  attendanceSessions AttendanceSession[]
  gradeItems GradeItem[]
  scheduleSlots ScheduleSlot[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([status])
  @@index([level])
  @@index([createdById])
}

model Lesson {
  id          String     @id @default(uuid())
  courseId    String
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  content     String?
  type        LessonType @default(TEXT)
  duration    String?
  order       Int        @default(0)
  isPreview   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@unique([courseId, order])
  @@index([courseId])
  @@index([createdAt])
  @@index([deletedAt, createdAt])
}

model ScheduleSlot {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([dayOfWeek])
}

model Enrollment {
  id          String           @id @default(uuid())
  studentId   String
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ACTIVE)
  progress    Int              @default(0)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([status])
}

model AttendanceSession {
  id        String             @id @default(uuid())
  courseId  String
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  heldAt    DateTime
  semester     Semester @default(GANJIL)
  academicYear String   @default("2026/2027")
  records   AttendanceRecord[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([courseId, heldAt])
  @@index([heldAt])
  @@index([createdAt])
  @@index([academicYear, semester])
  @@unique([courseId, title])
}

model AttendanceRecord {
  id                  String           @id @default(uuid())
  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentId           String
  student             StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status              AttendanceStatus @default(PRESENT)
  note                String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
  @@index([status])
}

model GradeItem {
  id          String        @id @default(uuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  maxScore    Int           @default(100)
  dueAt       DateTime?
  semester     Semester @default(GANJIL)
  academicYear String   @default("2026/2027")
  records     GradeRecord[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([courseId])
  @@index([dueAt])
  @@index([createdAt])
  @@index([academicYear, semester])
  @@unique([courseId, title])
}

model GradeRecord {
  id          String    @id @default(uuid())
  gradeItemId String
  gradeItem   GradeItem @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Int
  feedback    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([gradeItemId, studentId])
  @@index([studentId])
}

// Rapor per santri per periode. Nilai akhir di-snapshot saat dibuat;
// setelah PUBLISHED, isi rapor tidak berubah walau nilai sumber diedit.
model ReportCard {
  id           String           @id @default(uuid())
  studentId    String
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester     Semester
  academicYear String
  homeroomNote String?
  status       ReportCardStatus @default(DRAFT)
  publishedAt  DateTime?
  createdById  String?
  createdBy    User?            @relation("ReportCardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entries      ReportCardEntry[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, semester, academicYear])
  @@index([status])
  @@index([academicYear, semester])
}

// Satu baris rapor per mata pelajaran. courseTitle disimpan sebagai snapshot.
model ReportCardEntry {
  id           String     @id @default(uuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  courseId     String?
  courseTitle  String
  finalScore   Int
  present      Int        @default(0)
  late         Int        @default(0)
  absent       Int        @default(0)
  excused      Int        @default(0)

  @@unique([reportCardId, courseTitle])
  @@index([courseId])
}

// Pengumuman / info yang dikirim sekolah ke orang tua. level null = semua jenjang.
model Announcement {
  id        String          @id @default(uuid())
  title     String
  body      String
  level     EducationLevel?
  pinned    Boolean         @default(false)
  authorId  String?
  author    User?           @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([level])
  @@index([createdAt])
}

// Pendaftaran santri baru (PPDB). Saat diterima admin, dibuat akun orang tua + record santri.
model Admission {
  id               String          @id @default(uuid())
  childName        String
  level            EducationLevel
  gender           String?
  birthPlace       String?
  birthDate        DateTime?
  previousSchool   String?
  parentName       String
  parentPhone      String
  parentEmail      String
  address          String?
  note             String?
  status           AdmissionStatus @default(PENDING)
  reviewedAt       DateTime?
  reviewedById     String?
  createdStudentId String?
  createdParentId  String?
  submitterId       String?
  submitter         User?           @relation("AdmissionSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
  familyCardUrl     String?
  birthCertificateUrl String?
  previousReportUrl String?
  photoUrl          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([level])
  @@index([submitterId])
  @@index([createdAt])
}
